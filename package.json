{
  "name": "deepseek-desktop",
  "version": "0.2.2",
  "description": "Electron desktop shell for dsh web (http://127.0.0.1:3080/)",
  "author": "xiaobin <xiaobin@jbinfo.cn>",
  "repository": "https://github.com/phenix-base/deepseek-desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "bridge-client.js",
      "lock-screen.js"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3"
  }
}
